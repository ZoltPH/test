  "topup_formula": {
    "description": "For any custom sell_price_php not in the table above",
    "steps": [
      "cost_budget_php = sell_price_php * 0.40",
      "exact_yuan = cost_budget_php / 9.32",
      "yuan_to_topup = FLOOR(exact_yuan)",
      "real_cost_php = yuan_to_topup * 9.32",
      "profit_php = sell_price_php - real_cost_php"
    ]
  },
  "deduction_formula": {
    "description": "Per chat request, deduct from user's PHP balance",
    "formula": "cost = (input_tokens/1e6 * input) + (output_tokens/1e6 * output) + (cached_tokens/1e6 * cache_read)"
  }
